{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: app.main",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/project",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/project"
      }
    },
    {
      "name": "Pytest: project",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/project",
      "args": [
        "-q"
      ],
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/project"
      }
    }
  ]
}
